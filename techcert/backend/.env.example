PORT=5000
MONGODB_URI=mongodb://localhost:27017/signalforge
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=24h

# Seeded on first run when the database is empty
ADMIN_EMAIL=admin@signalforge.ai
ADMIN_PASSWORD=admin123

# CoinMarketCap Agent Hub — https://pro.coinmarketcap.com/login
CMC_PRO_API_KEY=your_cmc_pro_api_key

# Trust Wallet Agent Kit — https://developer.trustwallet.com
TWAK_API_URL=your_twak_api_url
TWAK_API_KEY=your_twak_api_key
AGENT_EXECUTION_MODE=paper
AGENT_WALLET_ADDRESS=
AGENT_SLIPPAGE_BPS=100
AGENT_SIGNAL_POLL_SECONDS=30
STRATEGY_BACKTEST_INTERVAL_MINUTES=10

# BNB Chain testnet (required for live execution)
BNB_TESTNET_RPC=https://data-seed-prebsc-1-s1.binance.org:8545
PRIVATE_KEY=your_wallet_private_key

FRONTEND_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:5000/api

# Vercel backend deploy: set Root Directory to techcert/backend
# Required on Vercel: MONGODB_URI (Atlas), JWT_SECRET, ADMIN_EMAIL, ADMIN_PASSWORD
# Required for background monitoring while logged out: CRON_SECRET (Vercel sends Bearer token)
CRON_SECRET=your_long_random_cron_secret
AUTOMATION_WORKER_INTERVAL_MS=15000
